COMPOSE_PROJECT_NAME=ceremonial-flag-fold
FRONTEND_PORT=18328
BACKEND_PORT=19328
DB_PORT=17828
DB_PASSWORD=workbench_password
JWT_SECRET=local-demo-secret-ceremonial-flag-fold
SEED_DEMO=true
# 折态计算共用内存额度；单单估算占用 = 参考样数平方，超过总额直接拒绝。
FOLD_MEMORY_LIMIT=4096
# 单个 worker 进程内最多并发开算的单数（硬边界仍是内存额度）。
WORKER_CONCURRENCY=32
